# OVH Hébergement Perso (Apache). What GitHub Pages did on its own.
# Only FileInfo-class directives (like RewriteRule), so the file works whole or fails whole with a 500 at the first curl.
ErrorDocument 404 /404.html
RedirectMatch 404 ^/\.git
AddType font/woff2 .woff2
AddCharset utf-8 .js .css .xml .txt
RewriteEngine On
# OVH's load balancer ends TLS, so the port tells http from https (OVH's own .htaccess guide).
# Let's Encrypt renewals fetch /.well-known/acme-challenge/ over http: leave it alone. (A and (B or C).)
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{SERVER_PORT} ^80$ [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nokime.fr%{REQUEST_URI} [R=301,L]
# No "Index of" pages (OVH lists folders; "Options -Indexes" is another override class): a folder without index.html is a 404.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]
