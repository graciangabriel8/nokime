# OVH Hébergement Perso (Apache). What GitHub Pages did on its own.
# Only FileInfo-class directives (like RewriteRule), so the file works whole or fails whole with a 500 at the first curl.
ErrorDocument 404 /404.html
RedirectMatch 404 ^/\.git
AddType font/woff2 .woff2
AddCharset utf-8 .js .css .xml .txt
RewriteEngine On
# OVH's load balancer ends TLS, so the port tells http from https (OVH's own .htaccess guide).
# Let's Encrypt renewals fetch /.well-known/acme-challenge/ over http: leave it alone. Each rule is A and B and (C or D).
# nokime.com is the English address of the same files (js/site.js opens it in English): http and www.nokime.com move to it.
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} ^(www\.)?nokime\.com\.?(:\d+)?$ [NC]
RewriteCond %{SERVER_PORT} ^80$ [OR]
RewriteCond %{HTTP_HOST} !^nokime\.com$ [NC]
RewriteRule ^ https://nokime.com%{REQUEST_URI} [R=301,L]
# Every other name on this folder (www.nokime.fr, the cluster's own) and http move to nokime.fr.
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} !^nokime\.com$ [NC]
RewriteCond %{SERVER_PORT} ^80$ [OR]
RewriteCond %{HTTP_HOST} !^nokime\.fr$ [NC]
RewriteRule ^ https://nokime.fr%{REQUEST_URI} [R=301,L]
# No "Index of" pages (OVH lists folders; "Options -Indexes" is another override class): a folder without index.html is a 404.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]
